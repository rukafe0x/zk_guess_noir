# Starknet JSON-RPC HTTP endpoint (app + integration test)
STARKNET_NODE_URI=https://your-starknet-rpc.example/

# Starknet WebSocket endpoint (game status events in join_game_screen)
STARKNET_WSS=wss://your-starknet-ws.example/

# Deployed ZKPes game contract
CONTRACT_ADDRESS=0xYOUR_ZK_PES_CONTRACT

# STRK ERC-20 used for entry fee approve/transfer
STRK_TOKEN_ADDRESS=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d

# AVNU paymaster RPC (sponsored Argent account deploy)
AVNU_RPC=https://sepolia.paymaster.avnu.fi

# Optional: overrides hardcoded AVNU API key used by integration_test deploy-if-missing
# AVNU_API_KEY=your_avnu_api_key_here

# Optional / legacy UI helpers (nickname lookup; SeedPhraseScreen fields)
# ACCOUNT1_ADDRESS=0x...
# ACCOUNT1_NICKNAME=Player1
# ACCOUNT1_PRIVATE_KEY=0x...
# ACCOUNT2_ADDRESS=0x...
# ACCOUNT2_PRIVATE_KEY=0x...
# SEED_PHRASE=word1 word2 ... word12
# SECRET_ACCOUNT_ADDRESS=0x...

# Integration test players: Argent owner private keys only (address is derived).
# Accounts are deployed via AVNU if missing; fund with STRK for gameplay fees.
ACCOUNT1_SEPOLIA_ARGENTX_PK=0xYOUR_P1_OWNER_PRIVATE_KEY
ACCOUNT2_SEPOLIA_ARGENTX_PK=0xYOUR_P2_OWNER_PRIVATE_KEY
